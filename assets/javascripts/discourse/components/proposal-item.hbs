<div class="proposal" style={{this.pointer}}>
  <div class="proposal-title d-md-none">
    <div class="proposal-description t-ellipsis">
      {{this.safeTitle}}
    </div>
  </div>
  <div class="proposal-details">
    <div class="proposal-actions">
      <div class="proposal-title d-md-rev-none">
        <div class="proposal-description">
          {{this.safeTitle}}
        </div>
      </div>

      <div class="proposal-due-date t-light">
        {{#if this.showRedirectButton}}
          <button
            type="button"
            class="k-btn btn-info pt-2 pb-2"
            onclick={{this.redirect}}
          >
            View proposal
            {{d-icon "link"}}
          </button>
        {{/if}}
        <div class="date">
          {{this.text}}
        </div>
        {{! <span class="redirect-text">
      </span> }}
      </div>
    </div>
    <div class="vote-breakdown">
      {{#if this.shielded}}
        <div class="t-light">
          {{d-icon "lock"}}
          Shielded vote &mdash; results are revealed when voting ends
        </div>
      {{else}}
        {{vote-breakdown loading=this.loading breakdown=this.proposal.voteBreakdown proposalUrl=this.link}}
      {{/if}}
    </div>
  </div>
</div>

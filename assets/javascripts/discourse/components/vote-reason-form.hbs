{{#if this.siteSettings.Show_vote_reason_form}}
  {{#unless this.hideButton}}
    <button
      type="button"
      class="__karma-send-reason-btn k-btn btn-link"
      onClick={{this.onClose}}
    >
      Submit vote reason
    </button>
  {{/unless}}
  <div
    id={{this.modalId}}
    class="__karma-vote-form-modal"
    style="display:none;opacity:0;transform:translateY(20px)"
  >
    {{#if this.loading}}
      {{karma-loading message="Submitting data, please wait."}}
    {{else}}
      {{#if this.message.length}}
        <div class="karma-form-submitted-message">
          <p>
            {{this.message}}
          </p>
        </div>
      {{else}}
        <div class="modal-body" onClick={{this.isOutside}}>
          <div class="modal-content">
            <div class="backdrop" onClick={{this.onClose}}>
            </div>
            <form onSubmit={{this.submit}}>
              <div class="close-button" onClick={{this.onClose}}>
                {{d-icon "times"}}
              </div>
              <div class="modal-header">
                <p>
                  Submit vote reason
                </p>
                <small>
                  When you sumit your voting reason, a link to the proposal along with your reason will be posted to your thread.
                  The reason will be displayed in the delegate dashboard in your voting history secion.
                </small>
              </div>
              <div class="form-reason">
                <label for="thread-id">
                  Select forum thread
                </label>
                <select
                  name="thread-id"
                  onchange={{this.setThreadId}}
                  required
                  class="k-input"
                >
                  {{#if this.proposalLoading}}
                    <option value="null" disabled selected={{eq this.threadId -1}}>
                      Loading...
                    </option>
                  {{else if (not this.threads.length)}}
                    <option value="null" disabled selected={{eq this.threadId -1}}>
                      We couldn't find any of your forum threads. Please, create a thread where you want your vote reasons posted
                    </option>
                  {{else}}
                    <option value="null" disabled selected={{eq this.threadId -1}}>
                      Select an option
                    </option>
                    {{! TODO: needs to check what about the category }}
                    {{! <option value="-2">
                    Create a topic
                  </option> }}
                  {{/if}}
                  {{#each this.threads as |thread index|}}
                    <option value={{index}}>
                      {{thread.name}}
                    </option>
                  {{/each}}
                </select>

                <label for="reason">
                  Proposal
                </label>
                <select
                  name="reason"
                  class="k-input"
                  placeholder="I voted FOR, because I believe this is a good proposal."
                  value={{this.proposalId}}
                  onchange={{this.setProposal}}
                  required
                >
                  <option value="null" disabled selected>
                    {{#if this.proposalLoading}}
                      Loading...
                    {{else}}
                      Select a proposal
                    {{/if}}
                  </option>
                  {{#each this.proposals as |proposal index|}}
                    <option value={{index}} selected={{eq this.proposalId index}}>
                      {{#if proposal.reason}}
                        ✔
                      {{/if}}
                      ({{proposal.type}})
                      {{proposal.title}}
                    </option>
                  {{/each}}
                </select>
                <br>
                <label for="reason">
                  Reason
                </label>
                <div class="editor-large">
                  {{d-editor
                    value=this.form.recommendation
                    placeholder="vote_reason_form.reason"
                  }}
                </div>
                <br>
              </div>
              {{#if this.errors.length}}
                {{#each this.errors as |error|}}
                  <span class="error" style="color:var(--danger)">
                    {{error}}
                  </span>
                  <br>
                {{/each}}
              {{/if}}
              <div class="footer">
                <div>
                  {{#if this.hasPostId}}
                    You have already submitted a
                    <a
                      rel="noreferrer noopener"
                      target="_blank"
                      href={{html-safe (concat "/p/" this.form.postId)}}
                    >
                      vote reason
                    </a>
                  {{/if}}
                </div>
                <div>
                  <button
                    type="button"
                    class="k-btn btn-link"
                    onClick={{this.onClose}}
                  >
                    Cancel
                  </button>
                  <button type="submit" class="k-btn btn-info">
                    {{#if this.form.postId}}
                      Update
                    {{else}}
                      Submit
                    {{/if}}
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      {{/if}}
    {{/if}}
  </div>
{{/if}}

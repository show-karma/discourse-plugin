<div class="voting-item">
  <div class="details">
    <p class="name">{{this.safeProposal}}</p>
    <div class="status-container">
      <p class="chain">{{this.vote.voteMethod}}</p>
      <p class="executed">Executed {{this.vote.executed}}</p>
    </div>
  </div>
  <div class="decision">
    <div>
      {{this.icon}}
    </div>
    <div>
      {{!-- {{#if (eq this.currentUser.username profile.ensName)}}
        {{vote-reason-form profile=profile vote=vote}}
      {{/if}} --}}
    </div>
  </div>
</div>
